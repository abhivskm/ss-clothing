# Copy of the settings this site needs. Real values live in Vercel
# (Project → Settings → Environment Variables). To use them locally run:
#   vercel env pull .env.local
# Never commit .env.local.

# Public URL of the site, used for SEO and in WhatsApp enquiry links.
# Leave unset until you buy a domain: the Vercel URL is used automatically.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Neon Postgres database (added automatically by the Vercel Neon integration)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Vercel Blob store for product photos (added automatically when the store is connected)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Admin portal login
ADMIN_PASSWORD=choose-a-strong-password
# Long random string used to sign the login cookie. Changing it logs everyone out.
SESSION_SECRET=generate-a-long-random-string

# Optional analytics settings (defaults shown)
# Time zone used to group visits into days and hours on the dashboard
ANALYTICS_TIMEZONE=Asia/Kolkata
# A visitor counts as "live" while their open tab was active within this many minutes
ANALYTICS_ACTIVE_MINUTES=5
